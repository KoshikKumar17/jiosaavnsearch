{
  "name": "jiosaavnsearch",
  "version": "1.0.0",
  "description": "Unofficial JioSaavn API - deploy on Cloudflare, Vercel, Netlify, Render or Docker",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "dev:cf": "wrangler dev",
    "deploy:cf": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "node-forge": "^1.3.1",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.2",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
